{
  "name": "n8n-nodes-socialpod",
  "version": "1.1.0",
  "description": "n8n community node for SocialPod — schedule and manage social media posts across Bluesky, Instagram, Twitter/X, Mastodon, Threads, LinkedIn, and YouTube",
  "keywords": [
    "n8n-community-node-package",
    "socialpod",
    "social-media",
    "bluesky",
    "instagram",
    "twitter",
    "mastodon",
    "threads",
    "linkedin",
    "youtube"
  ],
  "license": "MIT",
  "homepage": "https://github.com/michaelkleinhenz/socialpod",
  "author": {
    "name": "SocialPod"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/michaelkleinhenz/socialpod.git",
    "directory": "n8n-nodes-socialpod"
  },
  "main": "index.js",
  "scripts": {
    "build": "tsc && cp nodes/SocialPod/socialpod.svg dist/nodes/SocialPod/ && cp nodes/SocialPod/socialpod.svg dist/credentials/",
    "dev": "tsc --watch",
    "prepublishOnly": "npm run build"
  },
  "files": [
    "dist"
  ],
  "n8n": {
    "n8nNodesApiVersion": 1,
    "credentials": [
      "dist/credentials/SocialPodApi.credentials.js"
    ],
    "nodes": [
      "dist/nodes/SocialPod/SocialPod.node.js"
    ]
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "n8n-workflow": "*",
    "typescript": "^5.0.0"
  },
  "dependencies": {
    "form-data": "^4.0.0"
  },
  "peerDependencies": {
    "n8n-workflow": "*"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
