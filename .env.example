MONGO_HOST=mongodb:27017
MONGO_USER=socialmedia
# REQUIRED: change to a strong unique password before deploying
MONGO_PASSWORD=change-me
MONGO_DATABASE=socialmedia
# REQUIRED: set to a long random string (e.g. openssl rand -hex 32)
JWT_SECRET=change-me-in-production-use-a-long-random-string
# Public URL of this instance. It is also the OAuth issuer of the MCP server:
# Claude.ai / ChatGPT connectors only work when this is the public https URL.
APP_URL=http://localhost:8080
APP_PORT=8080
# S3-compatible bucket for uploaded images/videos/fonts (under uploads/) and for
# full-system backups (under backups/, Admin > Settings > Backups). Without it
# uploads are stored in MongoDB and backups are off; set it in production.
# AWS_ENDPOINT_URL is only needed for non-AWS storage (MinIO, R2, Railway, ...).
# AWS_S3_BUCKET_NAME=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_DEFAULT_REGION=us-east-1
# AWS_ENDPOINT_URL=
# Optional: allow additional CORS origins beyond APP_URL (comma-separated)
# CORS_ORIGINS=https://app.example.com,https://admin.example.com
